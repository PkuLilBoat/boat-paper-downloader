{
  "enabled": true,
  "login_url": null,
  "username": "your-student-id",
  "password": "your-password",
  "username_selectors": [
    "#user_name",
    "input[name='userName']"
  ],
  "password_selectors": [
    "#password",
    "input[name='password']"
  ],
  "submit_selectors": [
