    "#password",
    "#logon_button"
  ],
  "otp": {
    "enabled": true,
    "always_prompt": false,
    "detect_selectors": [
      "#otp_code",
      "#sms_code",
      "#valid_code"
    ],
    "prompt": "If PKU unified auth asks for OTP / SMS / CAPTCHA, complete it in the browser and then press Enter here to continue.",
    "success_selectors": []
  }
}
